{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/empreinte-politique/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|IBM Plex Mono|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, IBM Plex Mono, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='CandidateRailItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|disabled|key|ref|className|style|children)$/]",
        "message": "<CandidateRailItem> doesn't accept that prop. Declared props: value, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|explanation|tint|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: icon, value, label, explanation, tint."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeSwitchOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ModeSwitchOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutcomeSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|count|key|ref|className|style|children)$/]",
        "message": "<OutcomeSegment> doesn't accept that prop. Declared props: key, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<PanelNavItem> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScopeBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|color|active|dimmed|onClick|key|ref|className|style|children)$/]",
        "message": "<ScopeBar> doesn't accept that prop. Declared props: label, value, max, color, active, dimmed, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionKicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|inverse|key|ref|className|style|children)$/]",
        "message": "<SectionKicker> doesn't accept that prop. Declared props: children, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|as|icon|onClick|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, variant, as, icon, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|pill|active|inverse)$/]",
        "message": "<Tag> variant must be one of 'default' | 'pill' | 'active' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:span|button)$/]",
        "message": "<Tag> as must be one of 'span' | 'button'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoteBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:position|label|key|ref|className|style|children)$/]",
        "message": "<VoteBadge> doesn't accept that prop. Declared props: position, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoteBadge'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:pour|contre|abstention|absent)$/]",
        "message": "<VoteBadge> position must be one of 'pour' | 'contre' | 'abstention' | 'absent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|position|meta|key|ref|className|style|children)$/]",
        "message": "<VoteCard> doesn't accept that prop. Declared props: title, position, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoteCard'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:pour|contre|abstention|absent)$/]",
        "message": "<VoteCard> position must be one of 'pour' | 'contre' | 'abstention' | 'absent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
